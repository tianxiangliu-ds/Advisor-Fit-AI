# 复制为 .env 并填入真实值。API Key 绝不进入 Git 或前端。

# 可选：学术 API（OpenAlex 无需 Key 也可用，但配置免费 Key 可提高额度）
OPENALEX_MAILTO=you@example.com

# LLM 适配层（OpenAI 兼容）。默认不填时，运行流程会降级为“确定性规则 + 模板”，仍可产出画像与匹配，只是邮件草稿为空。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_STORE=false

# 抓取 UA
ADVISOR_FIT_USER_AGENT=AdvisorFitBot/0.1 (contact: you@example.com)
