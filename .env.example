# 复制为 .env 并填入真实值。API Key 绝不进入 Git 或前端。

# ---- 论文检索：默认不需要任何 Key（走免费公开学术库）----
# 填上邮箱可进入 OpenAlex / Crossref 的"礼貌池"，配额更稳；不填也能用
CONTACT_EMAIL=

# ---- 以下全部是可选增强 ----

# LLM 供应商：deepseek（默认）| openai | anthropic | ollama
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 以下留空则使用所选供应商的默认地址/模型，仅在有自定义需求时填写
LLM_BASE_URL=
LLM_MODEL=
LLM_STORE=false

# 万方学术文献检索（可选，用于补充中文文献；需在万方数据开放平台申请 appkey）
WANFANG_APP_KEY=

# AMiner 开放平台 Token（可选，按次计费；默认在 config/sources.json 里关闭）
AMINER_API_KEY=
