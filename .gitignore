# pytest 临时目录（必须留在项目内，见 conftest.py）
# 通过 .tmp/.gitkeep 让目录随仓库存在；pytest 不会创建父目录
.tmp/*
!.tmp/.gitkeep

# UI 测试留下的临时目录（沙箱下权限受限，内容无需入库）
tests/.ui-test-temp/
tests/.ui-full-test-temp/

# 真实上传文件（测试只允许匿名 fixtures）
*.pdf

